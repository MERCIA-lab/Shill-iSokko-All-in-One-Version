{
  "name": "imeek-commerce",
  "private": true,
  "version": "1.0.0",
  "description": "iMeek Cargo & Commerce Platform - monorepo (storefront, admin, mobile, API, microservices)",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@imeek/admin",
    "dev:web": "turbo run dev --filter=@imeek/web",
    "dev:api": "turbo run dev --filter=@imeek/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @imeek/database db:generate",
    "db:migrate": "pnpm --filter @imeek/database db:migrate",
    "db:studio": "pnpm --filter @imeek/database db:studio",
    "db:seed": "pnpm --filter @imeek/database db:seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
