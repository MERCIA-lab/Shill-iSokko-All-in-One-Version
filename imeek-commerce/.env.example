# ---- Shared ----
NODE_ENV=development

# ---- Database (packages/database) ----
DATABASE_URL="postgresql://imeek:imeek@localhost:5432/imeek_commerce?schema=public"

# ---- Auth (apps/api, services/auth-service) ----
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---- Redis (caching, queues) ----
REDIS_URL="redis://localhost:6379"

# ---- apps/api ----
API_PORT=4000
API_CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# ---- apps/web (storefront) ----
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_NAME="iMeek"

# ---- apps/admin ----
NEXT_PUBLIC_ADMIN_API_URL="http://localhost:4000"

# ---- services/marketplace-sync-service ----
AMAZON_SP_API_CLIENT_ID=""
AMAZON_SP_API_CLIENT_SECRET=""
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""

# ---- Object storage (product images, docs) ----
S3_BUCKET="imeek-assets"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
